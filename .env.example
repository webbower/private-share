# Copy to .env for local development. On Deno Deploy set these as environment
# variables on the app, not in a file.

APP_ENV=development

# 32+ random bytes. Signs session and PIN cookies.
#   deno eval "console.log(crypto.randomUUID()+crypto.randomUUID())"
APP_SECRET=

# Cloudflare R2. Create an API token scoped to Object Read & Write on one bucket.
#
# The bucket ALSO needs a CORS policy (browsers upload to it directly) and
# lifecycle rules (they are what actually delete expired files). Neither is an
# environment variable; see SETUP.md sections 2.3 and 2.4, and infra/*.json.
R2_ACCOUNT_ID=
R2_BUCKET=private-share
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Defaults to https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto

# Resend. The sending domain must be verified before it can mail anyone other
# than the account owner. Any provider with a JSON HTTP API works; see
# src/io/MailClient.js and SETUP.md section 3.
RESEND_API_KEY=
MAIL_FROM=Private Share <no-reply@yourdomain.com>
MAIL_ENDPOINT=https://api.resend.com/emails

LOG_LEVEL=debug
