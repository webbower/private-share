<%~ include("@partials/head", it) %>
<div class="sheet">
	<h1><%= share.title %></h1>
	<ul class="facts">
		<li><%= share.fileCount %> files</li>
		<li><%= share.displayTotalSize %></li>
		<li>Deleted <%= relativeExpiry(share.expiresAt, now) %></li>
	</ul>
	<% if (share.hasZip) { %>
	<a class="btn btn--block" href="/s/<%= share.id %>/download-all" rel="nofollow">Download all as a zip</a>
	<% } %>
	<ul class="manifest">
		<% share.files.forEach(function (file) { %>
		<li class="manifest__row">
			<span class="manifest__name">
				<strong><%= file.title %></strong>
				<span class="manifest__size"><%= file.displaySize %></span>
			</span>
			<a class="btn btn--small" href="/s/<%= share.id %>/f/<%= file.id %>/download" rel="nofollow">Download</a>
		</li>
		<% }); %>
	</ul>
</div>
<%~ include("@partials/foot", it) %>
