<%~ include("@partials/head", it) %>
<div class="sheet">
	<h1>Delete <%= share.isCollection ? "this collection" : "this file" %>?</h1>
	<p class="lede"><%= share.isCollection ? share.fileCount + " files, " : "" %><%= share.displayTotalSize %>. Deleting removes everything immediately and cannot be undone.</p>
	<%~ include("@partials/flash", it) %>
	<form method="post" action="/s/<%= share.id %>/delete">
		<% if (needsPin) { %>
		<div class="field">
			<label for="pin">PIN</label>
			<input id="pin" class="pin-entry" name="pin" type="text" inputmode="numeric"
				pattern="[0-9]*" maxlength="<%= pinLength %>" required autofocus spellcheck="false">
			<p class="field__hint">Confirm the PIN for this share to delete it.</p>
		</div>
		<% } %>
		<button type="submit" class="btn btn--block btn--danger">Delete permanently</button>
	</form>
	<div class="actions">
		<a class="btn btn--quiet" href="/s/<%= share.id %>">Keep it, go back</a>
	</div>
</div>
<%~ include("@partials/foot", it) %>
