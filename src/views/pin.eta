<%~ include("@partials/head", it) %>
<div class="sheet">
	<h1>Enter the PIN</h1>
	<p class="lede">Whoever sent you this link also sent you a <%= pinLength %>-digit PIN. Type it in to see what they shared.</p>
	<%~ include("@partials/flash", it) %>
	<% if (locked) { %>
	<p>Too many wrong tries. Wait <%= lockoutMinutes %> minutes and try again, or ask the sender to check the PIN.</p>
	<% } else { %>
	<form method="post" action="/s/<%= shareId %>/unlock">
		<div class="field">
			<label class="visually-hidden" for="pin">PIN</label>
			<input id="pin" class="pin-entry" name="pin" type="text" inputmode="numeric"
				autocomplete="one-time-code" pattern="[0-9]*" maxlength="<%= pinLength %>"
				required autofocus spellcheck="false">
		</div>
		<button type="submit" class="btn btn--block">Unlock</button>
	</form>
	<% } %>
</div>
<%~ include("@partials/foot", it) %>
